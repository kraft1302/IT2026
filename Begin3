#include <iostream>

using namespace std;

int main() {
    // Створюємо змінні для сторін, площі та периметра
    double a, b, S, P;

    // Просимо користувача ввести значення
    cout << "Введіть сторону a: ";
    cin >> a;

    cout << "Введіть сторону b: ";
    cin >> b;

    // Рахуємо за формулами
    S = a * b;
    P = 2 * (a + b);

    // Показуємо результат на екрані
    cout << "Площа (S) = " << S << endl;
    cout << "Периметр (P) = " << P << endl;

    return 0;
}
